{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Flowrensic",
  "description": "Forensics for durable execution, Temporal first.",
  "colors": {
    "primary": "#2563EB",
    "light": "#2563EB",
    "dark": "#111827"
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#FFFFFF"
    }
  },
  "fonts": {
    "heading": { "family": "Inter", "weight": 800 },
    "body": { "family": "Inter" }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://flowrensic.com"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "links": [
      { "label": "Docker Hub", "href": "https://hub.docker.com/u/flowrensic" },
      { "label": "npm package", "href": "https://www.npmjs.com/package/@flowrensic/node" }
    ]
  },
  "navigation": {
    "pages": ["quickstart"]
  },
  "footer": {
    "socials": {
      "website": "https://flowrensic.com"
    }
  }
}
